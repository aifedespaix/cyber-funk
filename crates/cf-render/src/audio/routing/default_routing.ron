// Matrice de routage par défaut : P2 §2.2 (constantes de temps par signal et par famille de cible) et §2.3
// (cartographie d'impact). Une ligne = une route ; deux routes sur la même cible se combinent par le maximum.
// Règle de P2 : plus la cible est massive, plus τ est long et plus la borne de pente est serrée ;
// un transitoire ne déplace jamais de géométrie.
(routes: [
    // ---- Sub-basse et punch : la masse ----
    Route(source: SubBass, detector: Envelope, curve: Pow(1.6),
          smooth: AttackReleaseSpring(attack_s: 0.030, release_s: 0.350, hz: 3.0, zeta: 0.9),
          target: MacroGeometry, gain: 1.0, clamp: (0.0, 1.0), slew: (up: 4.0, down: 2.0),
          quantize: None, limiter: None),
    Route(source: Punch, detector: Envelope, curve: Pow(1.4),
          smooth: AttackReleaseSpring(attack_s: 0.008, release_s: 0.180, hz: 5.0, zeta: 0.5),
          target: KickMass, gain: 1.0, clamp: (0.0, 1.0), slew: (up: 8.0, down: 4.0),
          quantize: None, limiter: None),
    Route(source: Punch, detector: Envelope, curve: Pow(1.4),
          smooth: AttackReleaseSpring(attack_s: 0.005, release_s: 0.100, hz: 4.0, zeta: 0.5),
          target: ScalePulse, gain: 1.0, clamp: (-0.3, 1.3), slew: (up: 20.0, down: 20.0),
          quantize: None, limiter: None),
    Route(source: SubBass, detector: Envelope, curve: Pow(1.6),
          smooth: AttackRelease(attack_s: 0.010, release_s: 0.250),
          target: EmissiveBass, gain: 1.0, clamp: (0.0, 1.0), slew: (up: 30.0, down: 12.0),
          quantize: None, limiter: None),
    Route(source: SubBass, detector: Peak(decay_s: 0.12, hold_s: 0.03), curve: Pow(1.6),
          smooth: None, target: CameraShake, gain: 1.0, clamp: (0.0, 1.0), slew: (up: 40.0, down: 6.0),
          quantize: None, limiter: None),
    Route(source: Punch, detector: Peak(decay_s: 0.09, hold_s: 0.02), curve: Pow(1.4),
          smooth: None, target: CameraShake, gain: 1.0, clamp: (0.0, 1.0), slew: (up: 40.0, down: 8.0),
          quantize: None, limiter: None),
    Route(source: Punch, detector: Peak(decay_s: 0.20, hold_s: 0.0), curve: Pow(1.4),
          smooth: None, target: CameraFov, gain: 1.0, clamp: (0.0, 1.0), slew: (up: 30.0, down: 5.0),
          quantize: None, limiter: None),
    Route(source: SubBass, detector: Envelope, curve: Pow(1.6),
          smooth: AttackRelease(attack_s: 0.020, release_s: 0.400),
          target: Bloom, gain: 1.0, clamp: (0.0, 1.0), slew: (up: 8.0, down: 3.0),
          quantize: None, limiter: Sweep),
    Route(source: SubBass, detector: Envelope, curve: Pow(1.6),
          smooth: AttackRelease(attack_s: 0.030, release_s: 0.350),
          target: FogDispersion, gain: 1.0, clamp: (0.0, 1.0), slew: (up: 4.0, down: 2.0),
          quantize: None, limiter: None),
    Route(source: Punch, detector: Envelope, curve: Pow(1.4),
          smooth: AttackRelease(attack_s: 0.010, release_s: 0.200),
          target: Puddles, gain: 1.0, clamp: (0.0, 1.0), slew: (up: 10.0, down: 4.0),
          quantize: None, limiter: None),

    // ---- Médiums : la surface ----
    Route(source: LowMid, detector: Envelope, curve: Pow(1.0),
          smooth: AttackRelease(attack_s: 0.300, release_s: 1.500),
          target: CableSwing, gain: 1.0, clamp: (0.0, 1.0), slew: (up: 3.0, down: 1.0),
          quantize: None, limiter: None),
    Route(source: HighMid, detector: Envelope, curve: Pow(0.9),
          smooth: AttackRelease(attack_s: 0.040, release_s: 0.250),
          target: MastBend, gain: 1.0, clamp: (0.0, 1.0), slew: (up: 4.0, down: 2.0),
          quantize: None, limiter: None),
    Route(source: HighMid, detector: Envelope, curve: Pow(0.9),
          smooth: AttackRelease(attack_s: 0.015, release_s: 0.200),
          target: NeonIntensity, gain: 1.0, clamp: (0.0, 1.0), slew: (up: 20.0, down: 6.0),
          quantize: None, limiter: None),
    Route(source: HighMid, detector: Envelope, curve: Pow(0.9),
          smooth: AttackRelease(attack_s: 0.015, release_s: 0.200),
          target: NeonSaturation, gain: 1.0, clamp: (0.0, 1.0), slew: (up: 20.0, down: 6.0),
          quantize: None, limiter: None),
    Route(source: HighMid, detector: Envelope, curve: Pow(0.9),
          smooth: AttackRelease(attack_s: 0.040, release_s: 0.300),
          target: HologramDepth, gain: 1.0, clamp: (0.0, 1.0), slew: (up: 6.0, down: 3.0),
          quantize: None, limiter: None),
    Route(source: HighMid, detector: Spectrum(bins: 32), curve: Linear,
          smooth: OneEuro(f_min: 1.0, beta: 0.5),
          target: WindowMeter, gain: 1.0, clamp: (0.0, 1.0), slew: (up: 20.0, down: 8.0),
          quantize: None, limiter: None),

    // ---- Transitoires : le grain ----
    Route(source: Transient, detector: Envelope, curve: Pow(0.8),
          smooth: AttackRelease(attack_s: 0.002, release_s: 0.090),
          target: Aberration, gain: 1.0, clamp: (0.0, 1.0), slew: (up: 200.0, down: 20.0),
          quantize: None, limiter: None),
    Route(source: Transient, detector: Envelope, curve: Pow(0.8),
          smooth: AttackRelease(attack_s: 0.002, release_s: 0.090),
          target: ParticleRate, gain: 1.0, clamp: (0.0, 1.0), slew: (up: 200.0, down: 20.0),
          quantize: None, limiter: None),
    Route(source: Transient, detector: Flux(z: 2.0), curve: Linear,
          smooth: AttackRelease(attack_s: 0.002, release_s: 0.100),
          target: ParticleBurst, gain: 1.0, clamp: (0.0, 1.0), slew: (up: 200.0, down: 20.0),
          quantize: None, limiter: None),
    Route(source: Transient, detector: Envelope, curve: Pow(0.8),
          smooth: AttackRelease(attack_s: 0.002, release_s: 0.090),
          target: TubeFlicker, gain: 1.0, clamp: (0.0, 1.0), slew: (up: 200.0, down: 20.0),
          quantize: None, limiter: None),
    // Flash laser : sur transitoire quantifié à la double croche, canal Flash du limiteur.
    Route(source: Transient, detector: Flux(z: 2.0), curve: Linear,
          smooth: None, target: LaserFlash, gain: 1.0, clamp: (0.0, 1.0), slew: (up: 200.0, down: 20.0),
          quantize: Sixteenth, limiter: Flash),
    // Défilement UV glitché : porte après z(F_TR) > 2,5, canal Flash du limiteur.
    Route(source: Transient, detector: Flux(z: 2.5), curve: Linear,
          smooth: None, target: Glitch, gain: 1.0, clamp: (0.0, 1.0), slew: (up: 200.0, down: 20.0),
          quantize: Beat, limiter: Flash),

    // ---- Énergie lente : l'ambiance ----
    Route(source: Slow, detector: Envelope, curve: Linear,
          smooth: AttackRelease(attack_s: 1.000, release_s: 3.000),
          target: Ambience, gain: 1.0, clamp: (0.0, 1.0), slew: (up: 0.5, down: 0.3),
          quantize: None, limiter: None),
])
