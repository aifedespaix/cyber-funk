// Niveau 0 de Sillage (`ACTS[0]` de engine/show/acts.ts, valeurs identiques) : le ciel d'attente, rien ne bouge ni ne vole.
// Les nombres sont ceux atteints au début de l'acte ; Sillage les fait glisser vers ceux du niveau suivant, ce que
// fait `cf_show::gates::GateBlender` entre deux looks. Fichier relu par crates/cf-show/tests/levels.rs.
// Couches, palette et teinte : Sillage n'en règle pas par niveau, donc tout plein et palette inchangée.
Look(
    version: 1,
    id: "niveau-0-pre-intro",
    name: "Niveau 0 · Pré-intro",
    world: "neon",
    layers: (background: 1.0, world: 1.0, foreground: 1.0, overlay: 1.0),
    palette: Inherit,
    hue_shift_deg: 0.0,
    gates: (
        max_floor: 0,
        flight_rate: 0.0,
        flight_on_drop_only: false,
        tricks: false,
        stunt_tiers: [],
        stunt_kinds: [],
        stunt_gap_scale: 1.6,
        shot_tiers: ["common"],
        shot_block: ["top-down", "god-view", "sky-tilt", "crane", "vertigo", "spiral", "strobe", "flyby", "dutch", "wheel", "takeoff", "touchdown", "dodge-pass", "barrel", "meteor-ride", "meteor-impact-watch", "moon-pass", "ringworld", "stunt-cam"],
        cut_grid: (calm: 16, groove: 16, peak: 16),
        salvo: false,
        events: [],
        event_rate: 0.0,
        meteor_rate: 0.0,
        meteor_shower: false,
        cruise: 1.0,
        ground_traffic: 0.0,
        fx: (rgb_split: 0.0, flash: 0.0, city_pulse: 0.1),
        ascension: false,
    ),
)
