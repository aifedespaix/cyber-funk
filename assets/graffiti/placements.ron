// Projecteurs holographiques posés à la main, un par taille pour l'exemple.
// z_m : distance le long de la route ; side : -1 gauche, 1 droite ; height_m : hauteur de la barre ;
// size : Small, Medium ou Large ; word : texte d'un mot de words.ron ; yaw_deg : rotation autour de la verticale.
[
    (z_m: 400.0, side: 1, height_m: 4.0, size: Small, word: "GRID", yaw_deg: 0.0),
    (z_m: 900.0, side: -1, height_m: 18.0, size: Medium, word: "NEON", yaw_deg: 10.0),
    (z_m: 1600.0, side: 1, height_m: 90.0, size: Large, word: "NIGHT CITY", yaw_deg: -15.0),
]
